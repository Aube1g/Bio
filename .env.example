PORT=8000
HOST=0.0.0.0
LANDING_PAGE=games
DATABASE_PATH=data/aubeig.sqlite
NODE_ENV=development

# Required in production, for example https://games.example.com
PUBLIC_ORIGIN=
# Enable only behind your trusted reverse proxy.
TRUST_PROXY=false
# Partitioned cookies for an HTTPS embedded development preview.
EMBEDDED_PREVIEW=false

# Configure in your own .env, never in frontend code or Git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Only the separate practice wallet is implemented at present.
WALLET_PROVIDER=local
